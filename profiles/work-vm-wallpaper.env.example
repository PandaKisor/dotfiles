# Copy this file to ~/.config/i3/wallpaper.env on a constrained work VM.

# Use static JPG, PNG, or WebP files even if VM detection is unavailable.
WALLPAPER_MODE=image

# Select once at login and use Mod+Shift+N for manual changes. This avoids
# periodic palette generation on a resource-constrained VM.
WALLPAPER_INTERVAL=0
