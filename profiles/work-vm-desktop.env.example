# Copy to ~/.config/i3/desktop.env on the work VM, then log out and back in.
# Pair with work-vm-wallpaper.env.example for static wallpaper without rotation.
# Calendar and system widgets remain available on Mod+0.
CAVA_ENABLED=0
MUSIC_ENABLED=0
# Rounded corners, shadows, and opacity via Picom XRender; xcompmgr fallback
# retains shadows/application transparency but cannot round corners.
# Use xcompmgr to skip Picom entirely, or off to disable compositing.
COMPOSITOR_MODE=vm
