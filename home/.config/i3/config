set $mod Mod4
font pango:MesloLGS Nerd Font Mono 10
floating_modifier $mod

# Keep the animated wallpaper visible and give tiled windows a card-like edge.
default_border pixel 2
default_floating_border pixel 2
gaps inner 10
gaps outer 8

# Terminal
set $term alacritty
bindsym $mod+Return exec $term

# Named scratchpads: launch once, then toggle the same marked window.
bindsym $mod+grave exec --no-startup-id ~/.config/i3/scratchpad.sh terminal
bindsym $mod+c exec --no-startup-id ~/.config/i3/scratchpad.sh calculator

# Kill focused window
bindsym $mod+q kill

# Managed popup windows never hold an exclusive keyboard grab. Escape is
# handled by i3 in popup mode and forcibly cleans up any stale Rofi process.
bindsym --release ctrl+space exec --no-startup-id ~/.config/i3/rofi-popup.sh -show drun

# Palette-aware system and session controls.
bindsym --release $mod+p exec --no-startup-id ~/.config/i3/control-center.sh

# Notification history and Do Not Disturb controls.
bindsym --release $mod+n exec --no-startup-id ~/.config/i3/notification-center.sh

# Focus
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move windows
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# Splits / layouts
bindsym $mod+h split h
bindsym $mod+v split v
bindsym $mod+t split toggle
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+w sticky toggle

# Floating / tiling
bindsym $mod+Shift+space floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1:main"
set $ws2 "2:media"
set $ws3 "3:dev"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10:widgets"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 exec --no-startup-id ~/.config/i3/widget-workspace.sh open

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# Optional session starters populate the usual workspace without permanently
# assigning applications or moving an existing window from somewhere else.
bindsym $mod+Control+1 exec --no-startup-id ~/.config/i3/workspace-session.sh game
bindsym $mod+Control+2 exec --no-startup-id ~/.config/i3/workspace-session.sh media
bindsym $mod+Control+3 exec --no-startup-id ~/.config/i3/workspace-session.sh dev

# Reload / restart / exit
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3 and end this X session?' -b 'Yes, exit i3' 'i3-msg exit'"

# Resize mode
mode "resize" {
        bindsym Left resize shrink width 5 px or 5 ppt
        bindsym Down resize grow height 5 px or 5 ppt
        bindsym Up resize shrink height 5 px or 5 ppt
        bindsym Right resize grow width 5 px or 5 ppt

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}
bindsym $mod+r mode "resize"

# Active only while one of the managed Rofi pop-outs is alive. Because Rofi is
# a normal window in this mode, i3 always receives Escape and can release focus.
mode "popup-menu" {
        bindsym Escape exec --no-startup-id ~/.config/i3/dismiss-popup.sh
        bindsym Control+g exec --no-startup-id ~/.config/i3/dismiss-popup.sh
}

########################################################################
# Status bar
########################################################################

exec_always --no-startup-id ~/.config/polybar/launch.sh

########################################################################
# Window colors / borders
########################################################################

# Static defaults keep i3 usable before Pywal has generated its cache. The
# optional include below repeats these client directives with generated colors.
set $fallback_background     #0B1118
set $fallback_foreground     #D8DEE9
set $fallback_foreground_alt #9AA7B2
set $fallback_muted          #4C566A
set $fallback_focus          #88C0D0
set $fallback_alert          #BF616A

# class                 border  backgr. text    indicator child_border
client.focused          $fallback_focus      $fallback_background $fallback_foreground     $fallback_focus      $fallback_focus
client.focused_inactive $fallback_background $fallback_background $fallback_foreground_alt $fallback_background $fallback_background
client.unfocused        $fallback_background $fallback_background $fallback_muted          $fallback_background $fallback_background
client.urgent           $fallback_alert      $fallback_alert      $fallback_background     $fallback_alert      $fallback_alert
client.placeholder      $fallback_background $fallback_background $fallback_foreground     $fallback_background $fallback_background
client.background       $fallback_background

# i3 expands variables in a parent config before parsing its includes, so a
# variable defined by this generated file cannot be consumed above. The file is
# self-contained and overrides the fallback client directives directly.
include ~/.cache/wal/colors-i3.conf

########################################################################
# Floating rules
########################################################################

# Some Electron and layout-restored windows can retain a borderless container
# state. Normalize every managed application when it appears, and refresh
# already-open applications after each preserving i3 restart.
for_window [class=".+"] border pixel 2
exec_always --no-startup-id i3-msg '[class=".+"] border pixel 2'

for_window [title="(?i)calculator"] floating enable
for_window [title="(?i)timer"] floating enable
for_window [class="(?i)mpv"] floating enable
for_window [class="(?i)imv"] floating enable
for_window [class="(?i)zenity"] floating enable
for_window [class="(?i)^Rofi$"] floating enable, move position center, border pixel 2
for_window [class="(?i)cachyos-welcome"] floating enable
for_window [class="(?i)firefox"] floating disable
for_window [class="(?i)^copyq$"] floating enable, resize set 420 360, move position center, border pixel 2
# Widget workspace geometry uses a responsive three-column grid. The three
# upper cards occupy 31-by-43 percent each; Cava spans the lower row.
for_window [class="^com[.]github[.]th-ch[.]youtube-music$"] floating enable, resize set 31 ppt 43 ppt, move position 1 ppt 4 ppt, border pixel 2
for_window [class="^i3-widget-calendar$"] floating enable, resize set 31 ppt 43 ppt, move position 34 ppt 4 ppt, border pixel 2
for_window [class="^i3-widget-system$"] floating enable, resize set 31 ppt 43 ppt, move position 67 ppt 4 ppt, border pixel 2
for_window [class="^i3-widget-cava$"] floating enable, resize set 98 ppt 20 ppt, move position 1 ppt 50 ppt, border pixel 2

# Persistent, low-attention applications live together off the main workspace.
assign [class="^com[.]github[.]th-ch[.]youtube-music$"] $ws10
assign [class="^i3-widget-calendar$"] $ws10
assign [class="^i3-widget-system$"] $ws10
assign [class="^i3-widget-cava$"] $ws10

# Optional machine/role-specific assignments and startup applications. The
# tracked placeholder ensures this wildcard always resolves to at least one
# file; add an ignored 90-local.conf for personal or workplace differences.
include ~/.config/i3/config.d/*.conf

########################################################################
# Hotkeys
########################################################################

# Palette-matched volume and display-brightness overlays.
bindsym XF86AudioRaiseVolume exec --no-startup-id ~/.config/i3/volume-osd.sh up
bindsym XF86AudioLowerVolume exec --no-startup-id ~/.config/i3/volume-osd.sh down
bindsym XF86AudioMute exec --no-startup-id ~/.config/i3/volume-osd.sh mute
bindsym XF86MonBrightnessUp exec --no-startup-id ~/.config/i3/brightness-osd.sh up
bindsym XF86MonBrightnessDown exec --no-startup-id ~/.config/i3/brightness-osd.sh down

# Control whichever MPRIS player was used most recently.
bindsym XF86AudioPlay exec --no-startup-id playerctl --player=playerctld play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl --player=playerctld pause
bindsym XF86AudioNext exec --no-startup-id playerctl --player=playerctld next
bindsym XF86AudioPrev exec --no-startup-id playerctl --player=playerctld previous
bindsym XF86AudioStop exec --no-startup-id playerctl --player=playerctld stop

# Screenshot like Windows Snipping Tool
bindsym $mod+Shift+s exec flameshot gui

# Select another image or video and regenerate the desktop palette.
bindsym $mod+Shift+n exec --no-startup-id ~/.config/i3/live-wallpaper.sh --next

# Clipboard history
bindsym $mod+Shift+v exec copyq show

# Audio control panel scratchpad
bindsym $mod+Shift+a exec --no-startup-id ~/.config/i3/scratchpad.sh audio

# Open the widget workspace and focus or launch its music application.
bindsym $mod+m exec --no-startup-id ~/.config/i3/music-player.sh

# File manager
bindsym $mod+Shift+f exec thunar

# System monitor
bindsym $mod+Shift+b exec alacritty -e btop

# Password manager
bindsym $mod+Shift+k exec keepassxc

# Palette-aware lock screen with a clock and authentication feedback.
bindsym $mod+l exec --no-startup-id ~/.config/i3/lock-screen.sh

########################################################################
# Autoload
########################################################################

# Standard automatic split selection. Do not run this together with the old
# quadrant-tiling.py helper; both react to the same i3 window events.
exec_always --no-startup-id ~/.config/i3/start-autotiling.sh

# Monitor layout and machine-local wallpaper commands belong in this untracked
# hook. Start from the example in the dotfiles repository when needed.
exec --no-startup-id sh -c 'test -x "$HOME/.config/i3/local-startup.sh" && exec "$HOME/.config/i3/local-startup.sh"'


# Startup services using packages you already have.
exec --no-startup-id dunst
exec_always --no-startup-id ~/.config/i3/start-picom.sh
exec --no-startup-id copyq --start-server
exec --no-startup-id ~/.config/i3/music-player.sh --daemon

# Name only workspaces that already exist; the standard bindings create any
# missing named workspace on demand.
exec_always --no-startup-id ~/.config/i3/workspace-session.sh names

# Keep the widget workspace populated without changing the startup workspace.
# The monitor skips missing packages, never duplicates existing cards, and
# restores a widget if its application exits.
exec --no-startup-id ~/.config/i3/widget-workspace.sh monitor

# Pear shares the widget workspace. Give audio time to initialize at login;
# the autostart helper neither switches workspace nor opens a browser fallback.
exec --no-startup-id ~/.config/i3/music-player.sh --autostart

# Selects a static image on VMs or an MP4 on physical hosts, then generates the
# matching Pywal palette. This uses exec so its i3 restart cannot create a loop.
exec --no-startup-id ~/.config/i3/live-wallpaper.sh

# Selects another wallpaper after 30 unpaused minutes; fullscreen pauses it.
# Also manages fullscreen animation pause. A runtime lock keeps
# this daemon unique across i3 reloads and restarts.
exec_always --no-startup-id sh -c 'exec "$HOME/.config/i3/wallpaper-rotation.sh" </dev/null >/dev/null 2>&1'

# nm-applet requires a system tray. Polybar is intentionally tray-free now,
# so this is disabled to avoid hidden background tray clutter.
#exec --no-startup-id nm-applet

# Optional later, only if installed.
#exec --no-startup-id redshift
#exec --no-startup-id dex -a -s /etc/xdg/autostart/:~/.config/autostart/
#exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1
